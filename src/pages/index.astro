---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your Name - Writer & Developer">
  <div class="max-w-5xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-3 gap-12 items-start">
      <!-- Bio Section - Left Side (2 columns) -->
      <div class="md:col-span-2 space-y-4">
        <p class="text-lg leading-relaxed text-gray-700">
          I'm Your Name, a writer and computer scientist. I grew up in [Your Location].
        </p>

        <p class="text-lg leading-relaxed text-gray-700">
          My focus is on [your focus area]. Previously, I worked on [previous work].
          I also founded and sold [company/project].
        </p>

        <p class="text-lg leading-relaxed text-gray-700">
          Running a startup taught me that being a founder is incredibly hard, so I try
          to support founders in any way I can.
        </p>

        <p class="text-lg leading-relaxed text-gray-700">
          I spend a lot of time reading (instead of working). I like books that make me
          think and are also fun to read.
        </p>

        <p class="text-lg leading-relaxed text-gray-700">
          I'm active on
          <a href="https://github.com/yourusername" class="text-blue-600 hover:text-blue-800 underline">GitHub</a>.
          I frequently speak at and occasionally host events.
        </p>

        <p class="text-lg leading-relaxed text-gray-700">
          I enjoy learning about fun technical challenges and collaborating with great teams.
          <a href="mailto:your.email@example.com" class="text-blue-600 hover:text-blue-800 underline">Reach out</a>
          if you want to find a way to work together!
        </p>
      </div>

      <!-- Profile Photo - Right Side (1 column) -->
      <div class="md:col-span-1 flex justify-center">
        <div class="w-64 h-64 rounded-full overflow-hidden bg-gray-200">
          <img
            src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=512&h=512&fit=crop"
            alt="Your Name"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
