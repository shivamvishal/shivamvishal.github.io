---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vishal Shivam - Software Engineer">
  <div class="max-w-5xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-3 gap-12 items-start">
      <!-- Bio Section - Left Side (2 columns) -->
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I’m Vishal, a software engineer working on distributed systems and data infrastructure.
          I grew up dismantling my toys to understand how they worked. The toys just got bigger.
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I work on data platforms at Bloomberg in London,
          building the access and governance layer that sits between people and petabytes —
          storage, catalogs, query engines.
          I like problems where scale, reliability, and design pull against each other.
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          Previously, I built big data and AI services at Oracle Cloud.
          Before that, at Informatica, I worked on data discovery and classification
          at data lake scale.
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I build small tools to make myself faster,
          and occasionally vibe-code clones of apps I don’t want to subscribe to.
          I contribute to open source, mostly Python and cloud data tooling.
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I studied Computer Science and Engineering at IIT (BHU) Varanasi.
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I like teaching what I learn, and give talks and workshops on
          distributed systems and AI workflows.
          Outside work, I backpack around Europe and start more research papers than I finish.
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I’m active on
          <a href="https://github.com/shivamvishal" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 underline">GitHub</a>
          and
          <a href="https://www.linkedin.com/in/vishal-shivam" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 underline">LinkedIn</a>
        </p>

        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">
          I enjoy fun technical challenges and great teams.
          <a href="mailto:vishalshivam007@gmail.com" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 underline">Reach out</a>
          if you want to find a way to work together!
        </p>
      </div>

      <!-- Profile Photo - Right Side (1 column) -->
      <div class="md:col-span-1 flex justify-center">
        <div class="w-64 h-64 rounded-full overflow-hidden bg-gray-200 dark:bg-gray-800">
          <img
            src="/images/vishal.jpg"
            alt="Vishal Shivam"
            class="w-full h-full object-cover"
            style="transform: translateY(-10%) scale(1.2);"
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
