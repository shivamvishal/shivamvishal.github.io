---
interface Props {
  title: string;
  date: Date;
  description: string;
  image: string;
  slug: string;
}

const { title, date, description, image, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a href={`/blog/${slug}`} class="block group">
  <article class="border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden hover:shadow-lg dark:hover:shadow-gray-900 transition-shadow">
    <div class="h-48 w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
      <img 
        src={image} 
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400">
        {title}
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">{formattedDate}</p>
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{description}</p>
    </div>
  </article>
</a>
